{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sheet-sync",
  "main": "src/index.js",

  // v920: 誤アカウント誤爆防止。本番 sheet-sync は Seishokai.saiyo@gmail.com's Account 固定。
  //   Account ID は公開情報 (dashboard URL に露出) なので git commit OK。
  "account_id": "14cbc5eefb5c8cc4a763619ef03f1ed8",

  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // 注: Cloudflare Free は cron 5 個/アカウントまで。既に他 Worker で埋まってるため
  //     ここでは cron trigger 登録せず、Aladdin ブラウザから 10 分毎に自動 fetch する。
  //     sync は冪等 (sync_source unique index) で並列発火安全。
  //   有料プラン ($5/月) にしたければ ↓ をアンコメントして再 deploy:
  // "triggers": { "crons": ["*/10 * * * *"] },

  // 環境変数 (secret は wrangler secret put で登録)
  //   SUPABASE_SERVICE_KEY → 秘密キー
  "vars": {
    "SUPABASE_URL": "https://ndlfqrvoejwgqfdtghmg.supabase.co",
    "SHEET_ID": "167IYM21HW0DGPlL1CrnCn4yTaTyC0KJU4f7gWyKtHf4",
    "CUTOFF_DATE": "2026-04-01",
    "MANUAL_TRIGGER_TOKEN": "aladdin-sync-2026"
  },

  "observability": { "enabled": true }
}
